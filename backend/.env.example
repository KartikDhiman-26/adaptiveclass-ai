# AdaptiveClass AI Environment Configuration Example

# PostgreSQL Connection String (Required)
# Format: postgresql+psycopg://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptive_db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Optional Gemini API Key (for Gemini 2.5 Flash insights)
# If left empty, AdaptiveClass AI automatically uses its built-in deterministic AI engine
GEMINI_API_KEY=

# JWT Secret Key for Session Authentication (Change this in production)
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
