# AdaptiveClass AI Frontend Environment Variables
# In production (e.g. Vercel), set this to your deployed FastAPI backend URL:
# Example: VITE_API_URL=https://adaptiveclass-backend.onrender.com
# In local development, if unset it defaults to: http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

