# ==============================================================================
# AdaptiveClass AI - Root .gitignore
# ==============================================================================

# Environment & Secrets (Never commit credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Whitelist environment example templates
!.env.example
!**/.env.example

# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & PostgreSQL Local Runtime Data
pgdata/
**/pgdata/
*.sqlite
*.sqlite3
*.db
*.log
server.log

# IDEs & Editor Configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
